+++ b/crates/proof/src/de/mod.rs
@@ -0,0 +1,273 @@
+//! German proofing.
+//!
+//! - **Spelling** against an installed Hunspell German dictionary (found by [`crate::hunspell`]:
+//!   `de_DE_frami`/`de_DE`, `de_AT_frami`/`de_AT` or `de_CH_frami`/`de_CH` from the OS, a package
+//!   manager or LibreOffice; not bundled — the igerman98 files are GPL-licensed). German builds
+//!   most words by compounding (`Haustürschlüssel`, `Geburtstagseinladung`), which WordCraft's own
+//!   [`crate::affix`] engine doesn't do, so this module checks with [`spellbook`], a complete
+//!   Hunspell implementation (compounds, `CHECKSHARPS`, `KEEPCASE`, `NEEDAFFIX`…). Without a
+//!   dictionary German text gets no spelling marks, as before.
+//! - **Suggestions** from the same dictionary (`Gebutstag` → `Geburtstag`, `schoen` → `schön`).
+//! - **Grammar**: none yet; German text gets spelling marks only.
+//!
+//! The run's region picks the dictionary first (`de-AT` → `de_AT`, `de-CH` → `de_CH`); any other
+//! installed German dictionary is the fallback, so `de-AT` text is checked even with only `de_DE`.
+
+use std::collections::HashMap;
+use std::sync::{Arc, RwLock};
+
+/// A loaded German dictionary.
+pub struct GermanDict {
+    dict: spellbook::Dictionary,
+}
+
+impl GermanDict {
+    /// Parse a Hunspell pair (already decoded to UTF-8).
+    pub fn from_hunspell(aff: &str, dic: &str) -> Result<Self, String> {
+        spellbook::Dictionary::new(aff, dic).map(|dict| GermanDict { dict }).map_err(|e| format!("German dictionary: {e}"))
+    }
+
+    pub fn check(&self, word: &str) -> bool {
+        self.dict.check(word)
+    }
+
+    pub fn suggest(&self, word: &str, max: usize) -> Vec<String> {
+        let mut out = Vec::new();
+        self.dict.suggest(word, &mut out);
+        out.truncate(max);
+        out
+    }
+}
+
+/// Dictionaries loaded so far, by region (`None` cached when none is installed).
+static DICTS: RwLock<Option<HashMap<Region, Option<Arc<GermanDict>>>>> = RwLock::new(None);
+
+/// German regions with their own Hunspell dictionary.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Region {
+    De,
+    At,
+    Ch,
+}
+
+impl Region {
+    /// The region of a BCP 47 tag (`de-AT`, `de_CH`, `de`): Germany when it names none.
+    pub fn from_tag(tag: Option<&str>) -> Region {
+        let region = tag.and_then(|t| t.split(['-', '_']).nth(1)).unwrap_or("");
+        if region.eq_ignore_ascii_case("at") {
+            Region::At
+        } else if region.eq_ignore_ascii_case("ch") || region.eq_ignore_ascii_case("li") {
+            Region::Ch
+        } else {
+            Region::De
+        }
+    }
+
+    /// Hunspell file names to try, this region first, then the other German ones.
+    fn names(self) -> &'static [&'static str] {
+        match self {
+            Region::De => &["de_DE_frami", "de_DE", "de", "de_AT_frami", "de_AT", "de_CH_frami", "de_CH"],
+            Region::At => &["de_AT_frami", "de_AT", "de_DE_frami", "de_DE", "de", "de_CH_frami", "de_CH"],
+            Region::Ch => &["de_CH_frami", "de_CH", "de_DE_frami", "de_DE", "de", "de_AT_frami", "de_AT"],
+        }
+    }
+}
+
+/// The German dictionary for `region` (loaded on first use), or `None` when none is installed.
+pub fn dictionary(region: Region) -> Option<Arc<GermanDict>> {
+    if let Some(map) = DICTS.read().unwrap_or_else(|e| e.into_inner()).as_ref()
+        && let Some(d) = map.get(&region)
+    {
+        return d.clone();
+    }
+    let loaded = load_installed(region).map(Arc::new);
+    let mut slot = DICTS.write().unwrap_or_else(|e| e.into_inner());
+    slot.get_or_insert_with(HashMap::new).entry(region).or_insert(loaded).clone()
+}
+
+fn load_installed(region: Region) -> Option<GermanDict> {
+    let Some((aff, dic)) = crate::hunspell::find(region.names()) else {
+        log::info!("German spelling: no Hunspell de_DE/de_AT/de_CH dictionary installed");
+        return None;
+    };
+    let read = |p: &std::path::Path| std::fs::read(p).map_err(|e| format!("{}: {e}", p.display()));
+    let loaded = read(&aff)
+        .and_then(|a| read(&dic).map(|d| (a, d)))
+        .and_then(|(a, d)| crate::hunspell::decode(&a, &d))
+        .and_then(|(a, d)| GermanDict::from_hunspell(&a, &d));
+    match loaded {
+        Ok(d) => {
+            log::info!("German spelling: {}", dic.display());
+            Some(d)
+        }
+        Err(e) => {
+            log::warn!("German spelling: {e}");
+            None
+        }
+    }
+}
+
+/// Use this dictionary for every German region from now on (Hunspell text decoded to UTF-8).
+pub fn install_dictionary(aff: &str, dic: &str) -> Result<(), String> {
+    let d = Arc::new(GermanDict::from_hunspell(aff, dic)?);
+    let mut map = HashMap::new();
+    for r in [Region::De, Region::At, Region::Ch] {
+        map.insert(r, Some(d.clone()));
+    }
+    *DICTS.write().unwrap_or_else(|e| e.into_inner()) = Some(map);
+    Ok(())
+}
+
+/// Forget the loaded dictionaries, so the next check looks for installed ones again.
+pub fn reload_dictionary() {
+    *DICTS.write().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+/// The `.dic` file of the German dictionary found now (Germany's first); `None` when there is none.
+pub fn installed_path() -> Option<std::path::PathBuf> {
+    crate::hunspell::find(Region::De.names()).map(|(_, dic)| dic)
+}
+
+/// Is a German dictionary available (spelling is checked)?
+pub fn has_dictionary() -> bool {
+    dictionary(Region::De).is_some()
+}
+
+/// Is `word` spelled correctly in German (Germany's dictionary first)?
+pub fn is_correct(word: &str) -> bool {
+    is_correct_in(word, Region::De)
+}
+
+/// Is `word` spelled correctly in German as written in `region`? Numbers, single letters, short
+/// words in capitals (acronyms: `ORF`, `ÖBB`), words with digits and words in other scripts are
+/// accepted, and so is every word when no German dictionary is installed.
+pub fn is_correct_in(word: &str, region: Region) -> bool {
+    match dictionary(region) {
+        Some(d) => is_correct_with(&d, word),
+        None => true, // no German dictionary installed: no spelling marks
+    }
+}
+
+/// [`is_correct`] against a given dictionary.
+pub fn is_correct_with(d: &GermanDict, word: &str) -> bool {
+    let w = word.trim_matches(|c: char| !c.is_alphanumeric() && c != '-');
+    let w = w.trim_matches('-');
+    let n = w.chars().count();
+    if n <= 1 || w.chars().any(|c| c.is_ascii_digit()) || !w.chars().any(char::is_alphabetic) {
+        return true;
+    }
+    if w.chars().all(|c| !c.is_lowercase()) && n <= 6 {
+        return true; // acronyms
+    }
+    if !w.chars().any(is_latin_letter) {
+        return true; // other scripts: no dictionary
+    }
+    if w.contains('-') {
+        // Bindestrich-Komposita (`E-Mail-Adresse`, `Vorarlberg-Reise`): the whole word, or every part
+        return known(d, w) || w.split('-').all(|p| p.chars().count() <= 1 || known(d, p));
+    }
+    known(d, w)
+}
+
+/// Is one word in the dictionary or the user dictionary?
+fn known(d: &GermanDict, w: &str) -> bool {
+    d.check(w) || crate::in_user_dictionary(&w.to_lowercase())
+}
+
+/// Suggestions for a misspelled German word (Germany's dictionary first), best first.
+pub fn suggest(word: &str, max: usize) -> Vec<String> {
+    dictionary(Region::De).map(|d| d.suggest(word, max)).unwrap_or_default()
+}
+
+/// Is `c` a letter of the Latin script (the only one the German dictionaries cover)?
+fn is_latin_letter(c: char) -> bool {
+    c.is_alphabetic() && (c < '\u{0250}' || ('\u{1E00}'..='\u{1EFF}').contains(&c))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A tiny German Hunspell dictionary written for these tests (the real ones are GPL and large):
+    /// plurals and verb endings by affixes, and compounding with Fugen-s like igerman98.
+    pub(crate) const AFF: &str = "SET UTF-8\nTRY esnrtiaodlucgmhbfwkzpvüäößjyxq\n\
+        COMPOUNDBEGIN x\nCOMPOUNDMIDDLE y\nCOMPOUNDEND z\nONLYINCOMPOUND c\nCOMPOUNDMIN 3\n\
+        SFX P Y 2\nSFX P 0 e .\nSFX P 0 en .\n\
+        SFX V Y 3\nSFX V 0 st .\nSFX V 0 t .\nSFX V 0 en .\n";
+    pub(crate) const DIC: &str = "15\nHaus/Px\nTür/P\ntür/Pyzc\nSchlüssel\nschlüssel/zc\nGeburtstag/P\nGeburtstags/xc\n\
+        Einladung/P\neinladung/Pzc\nStraße/P\ngeh/V\nschön/P\nJänner\nich\nund\n";
+
+    fn test_dict() -> GermanDict {
+        GermanDict::from_hunspell(AFF, DIC).expect("test dictionary")
+    }
+
+    #[test]
+    fn region_from_tag() {
+        assert_eq!(Region::from_tag(Some("de-AT")), Region::At);
+        assert_eq!(Region::from_tag(Some("de_CH")), Region::Ch);
+        assert_eq!(Region::from_tag(Some("de-LI")), Region::Ch);
+        assert_eq!(Region::from_tag(Some("de")), Region::De);
+        assert_eq!(Region::from_tag(None), Region::De);
+        assert_eq!(Region::At.names()[0], "de_AT_frami");
+    }
+
+    #[test]
+    fn words_compounds_and_affixes_are_correct() {
+        let d = test_dict();
+        for w in ["Haus", "Türen", "Haustür", "Haustürschlüssel", "Geburtstagseinladung", "gehst", "geht", "schöne", "Straße", "Jänner",
+                  "ORF", "2026", "a", "E-Haus"] {
+            assert!(is_correct_with(&d, w), "{w}");
+        }
+        // Compound-only forms aren't words on their own
+        assert!(!is_correct_with(&d, "tür") && !is_correct_with(&d, "Geburtstags"));
+    }
+
+    #[test]
+    fn misspellings_are_flagged_with_suggestions() {
+        let d = test_dict();
+        for w in ["Gebutstag", "Strase", "ihc", "Hausschlüsel", "schoen"] {
+            assert!(!is_correct_with(&d, w), "{w}");
+        }
+        assert!(d.suggest("Gebutstag", 5).contains(&"Geburtstag".to_string()), "{:?}", d.suggest("Gebutstag", 5));
+        assert!(d.suggest("ihc", 5).contains(&"ich".to_string()), "{:?}", d.suggest("ihc", 5));
+    }
+
+    #[test]
+    fn dictionary_files_are_found_by_region() {
+        let dir = std::env::temp_dir().join(format!("wc-de-{}", std::process::id()));
+        let _ = std::fs::create_dir_all(&dir);
+        std::fs::write(dir.join("de_AT_frami.aff"), AFF).expect("aff");
+        std::fs::write(dir.join("de_AT_frami.dic"), DIC).expect("dic");
+        let found = crate::hunspell::find_in(&dir, Region::De.names());
+        assert!(found.as_ref().is_some_and(|(_, d)| d.ends_with("de_AT_frami.dic")), "{found:?}: Austria is the fallback for Germany");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// With a real igerman98 dictionary installed (CI sets `WORDCRAFT_DICTIONARIES`), German is
+    /// checked for real: compounds, Austrian words, suggestions. Skipped when none is installed.
+    #[test]
+    fn real_dictionary_when_installed() {
+        let Some((aff, dic)) = crate::hunspell::find(Region::At.names()) else {
+            return;
+        };
+        let (a, d) = crate::hunspell::decode(&std::fs::read(aff).unwrap(), &std::fs::read(dic).unwrap()).unwrap();
+        let d = GermanDict::from_hunspell(&a, &d).expect("the igerman98 dictionary loads");
+        for w in ["Haustürschlüssel", "Geburtstagseinladung", "Straße", "Jänner", "Kaffeehaus", "gehst", "schöne", "Bürgermeisterwahl"] {
+            assert!(is_correct_with(&d, w), "{w}");
+        }
+        for w in ["Gebutstag", "Strase", "schoen", "ihc"] {
+            assert!(!is_correct_with(&d, w), "{w}");
+        }
+        assert!(d.suggest("Gebutstag", 5).contains(&"Geburtstag".to_string()));
+        assert!(d.suggest("schoen", 5).contains(&"schön".to_string()));
+    }
+
+    #[test]
+    fn latin1_dictionaries_decode() {
+        let aff = b"SET ISO8859-1\n";
+        let dic = b"1\nStra\xdfe\n";
+        let (a, d) = crate::hunspell::decode(aff, dic).expect("ISO 8859-1 is supported");
+        assert!(a.starts_with("SET ISO8859-1"));
+        assert_eq!(d, "1\nStraße\n");
+    }
+}
